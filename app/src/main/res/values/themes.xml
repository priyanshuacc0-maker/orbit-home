<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal platform theme: the UI itself is drawn entirely in Compose. -->
    <style name="Theme.OrbitHome" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/orbit_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Home screen theme: the user's wallpaper must show through, so the window
         background is transparent and windowShowWallpaper is enabled. -->
    <style name="Theme.OrbitHome.Home" parent="Theme.OrbitHome">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
